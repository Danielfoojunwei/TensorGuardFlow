{
  "name": "tensorguard-frontend",
  "private": true,
  "version": "2.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint src --ext .vue,.js --report-unused-disable-directives --max-warnings 0",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@vue-flow/background": "^1.3.0",
    "@vue-flow/controls": "^1.1.1",
    "@vue-flow/core": "^1.33.2",
    "@vue-flow/minimap": "^1.4.0",
    "@vueuse/core": "^10.9.0",
    "clsx": "^2.1.0",
    "d3": "^7.8.5",
    "lucide-vue-next": "^0.331.0",
    "pinia": "^2.1.7",
    "playwright": "^1.58.0",
    "tailwind-merge": "^2.2.1",
    "vue": "^3.4.19",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitest/coverage-v8": "^1.2.0",
    "@vue/test-utils": "^2.4.4",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.21.1",
    "happy-dom": "^13.3.8",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vitest": "^1.2.0",
    "vue-tsc": "^1.8.27"
  }
}
