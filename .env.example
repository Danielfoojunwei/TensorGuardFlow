# TensorGuard Environment Configuration
# Copy this file to .env and fill in your values
# Required variables are marked with [REQUIRED]

# =============================================================================
# GENERAL SETTINGS
# =============================================================================

# Runtime environment: development, staging, production
TG_ENVIRONMENT=development

# Logging level: DEBUG, INFO, WARNING, ERROR
TG_LOG_LEVEL=INFO

# =============================================================================
# SECURITY [REQUIRED IN PRODUCTION]
# =============================================================================

# JWT signing key - generate with: openssl rand -hex 32
# [REQUIRED] in production
TG_SECRET_KEY=

# Demo mode - NEVER enable in production
TG_DEMO_MODE=false

# Require real PQC libraries (auto-enabled in production)
TG_PQC_STRICT=true

# =============================================================================
# DATABASE [REQUIRED]
# =============================================================================

# Database connection URL
# SQLite (dev only): sqlite:///./tensorguard.db
# PostgreSQL: postgresql://user:password@host:5432/dbname
# [REQUIRED] in production - must be PostgreSQL
DATABASE_URL=sqlite:///./tensorguard.db

# PostgreSQL password for docker-compose
# [REQUIRED] when using production docker profile
POSTGRES_PASSWORD=

# Connection pool settings (PostgreSQL only)
TG_DB_POOL_SIZE=10
TG_DB_MAX_OVERFLOW=20
TG_DB_POOL_TIMEOUT=30
TG_DB_POOL_RECYCLE=3600
TG_DB_ECHO=false

# =============================================================================
# AUTHENTICATION
# =============================================================================

# Access token lifetime in minutes
TG_TOKEN_EXPIRE_MINUTES=30

# Refresh token lifetime in days
TG_REFRESH_TOKEN_EXPIRE_DAYS=7

# Minimum password length
TG_MIN_PASSWORD_LENGTH=12

# Require password complexity (mixed case, digits, special chars)
TG_REQUIRE_PASSWORD_COMPLEXITY=true

# =============================================================================
# CORS
# =============================================================================

# Comma-separated allowed origins (empty = restrictive default)
# Example: https://app.example.com,https://admin.example.com
TG_ALLOWED_ORIGINS=

# Allow credentials in CORS (requires explicit origins)
TG_ALLOW_CREDENTIALS=false

# =============================================================================
# NETWORKING
# =============================================================================

# Control plane URL
TG_CONTROL_PLANE_URL=http://localhost:8000

# Cloud API endpoint
TG_CLOUD_ENDPOINT=https://api.tensor-crate.ai

# Server ports
TG_DEFAULT_PORT=8080
TG_DASHBOARD_PORT=8000

# =============================================================================
# AGENT SETTINGS
# =============================================================================

# Fleet API key for agent authentication
TG_FLEET_API_KEY=

# Fleet ID for agent registration
TG_FLEET_ID=

# System metrics collection interval (seconds)
TG_SYSTEM_METRICS_INTERVAL=30

# =============================================================================
# CRYPTO PARAMETERS
# =============================================================================

# Security level in bits (128, 192, 256)
TG_SECURITY_LEVEL=128

# Maximum key uses before rotation
TG_MAX_KEY_USES=1000

# LWE lattice dimension
TG_LATTICE_DIMENSION=1024

# Enable experimental N2HE cryptography (research only)
TG_ENABLE_EXPERIMENTAL_CRYPTO=false

# =============================================================================
# PRIVACY PIPELINE (Differential Privacy)
# =============================================================================

# Total DP epsilon budget
TG_DP_EPSILON=1.0

# DP delta parameter
TG_DP_DELTA=1e-5

# Default gradient sparsity ratio
TG_DEFAULT_SPARSITY=0.01

# Gradient clipping norm
TG_MAX_GRADIENT_NORM=1.0

# =============================================================================
# OBSERVABILITY
# =============================================================================

# Enable OpenTelemetry tracing
TG_ENABLE_OTEL=false

# OTEL collector endpoint
TG_OTEL_ENDPOINT=http://localhost:4317

# Enable Prometheus metrics
TG_ENABLE_PROMETHEUS=false

# Prometheus metrics port
TG_PROMETHEUS_PORT=9090

# Add security headers to responses
TG_ENABLE_SECURITY_HEADERS=true

# =============================================================================
# RATE LIMITING
# =============================================================================

# Enable rate limiting (requires Redis)
TG_ENABLE_RATE_LIMITING=false

# Max login attempts before lockout
TG_MAX_LOGIN_ATTEMPTS=5

# Lockout duration after max attempts (minutes)
TG_LOCKOUT_DURATION_MINUTES=15

# =============================================================================
# EXTERNAL INTEGRATIONS (Optional)
# =============================================================================

# HuggingFace Hub token for model sync
HF_TOKEN=

# MLflow tracking URI
MLFLOW_TRACKING_URI=
